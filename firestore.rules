rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function authEmail() { return request.auth.token.email; }
    function userPath() { return /databases/$(database)/documents/authorizedUsers/$(authEmail()); }
    function authorized() { return signedIn() && exists(userPath()); }
    function myUser() { return get(userPath()); }
    function isParent() { return authorized() && myUser().data.role == 'parent'; }
    function isClient() { return authorized() && myUser().data.role == 'client'; }
    function isRegional() { return authorized() && myUser().data.role == 'regional'; }
    function myClient() { return myUser().data.get('clientproject', ''); }
    function mySector() { return myUser().data.get('sector', ''); }
    function myRegion() { return myUser().data.get('region', ''); }

    function clientScope(data) {
      return isClient()
        && data.get('clientproject', '') == myClient()
        && (mySector() == '' || data.get('sector', '') == mySector())
        && (myRegion() == '' || data.get('region', '') == myRegion());
    }

    function regionalScope(data) {
      return isRegional() && data.get('region', '') == myRegion();
    }

    function auditOwnedByCaller() {
      return authorized()
        && request.resource.data.userEmail == authEmail()
        && request.resource.data.role == myUser().data.role
        && (isParent()
            || (request.resource.data.get('clientproject', '') == myClient()
                && (mySector() == '' || request.resource.data.get('sector', '') == mySector())
                && (myRegion() == '' || request.resource.data.get('region', '') == myRegion()))
            || (isRegional() && request.resource.data.get('region', '') == myRegion()));
    }

    match /authorizedUsers/{email} {
      allow read: if authorized() && (isParent() || email == authEmail());
      allow create, update, delete: if isParent();
    }

    match /regions/{regionId} {
      allow read: if isParent() || (isRegional() && resource.data.name == myRegion());
      allow create, update, delete: if isParent();
    }

    match /sectors/{sectorId} {
      allow read: if isParent() || (isRegional() && resource.data.regionName == myRegion());
      allow create: if isParent() || (isRegional() && request.resource.data.regionName == myRegion());
      allow update: if isParent() || (
        isRegional()
        && resource.data.regionName == myRegion()
        && request.resource.data.regionName == myRegion()
      );
      allow delete: if isParent();
    }

    match /records/{recordId} {
      allow read: if isParent() || clientScope(resource.data) || regionalScope(resource.data);
      allow create: if isParent() || clientScope(request.resource.data) || regionalScope(request.resource.data);
      allow update: if isParent()
                    || (clientScope(resource.data) && clientScope(request.resource.data))
                    || (regionalScope(resource.data) && regionalScope(request.resource.data));
      allow delete: if isParent() || clientScope(resource.data) || regionalScope(resource.data);
    }

    match /recycleBin/{recycleId} {
      allow read: if isParent();
      allow create: if isParent()
                    || (clientScope(request.resource.data.recordData)
                        && request.resource.data.originalRecordId is string
                        && get(/databases/$(database)/documents/records/$(request.resource.data.originalRecordId)).data.clientproject == myClient())
                    || (regionalScope(request.resource.data.recordData)
                        && request.resource.data.originalRecordId is string
                        && get(/databases/$(database)/documents/records/$(request.resource.data.originalRecordId)).data.region == myRegion());
      allow update: if false;
      allow delete: if isParent();
    }

    match /auditLogs/{logId} {
      allow read: if isParent();
      allow create: if auditOwnedByCaller();
      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow read, create: if isParent();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
