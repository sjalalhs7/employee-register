rules_version = '2';

// ============================================================================
// MSM LONGROLL DATABASE — Firestore Security Rules
// FINAL 1-STEP FIX
// Deploy target: msm-security-guards-database
//
// IMPORTANT FIXES:
// 1) CREATE operations use request.resource.data (not resource.data).
// 2) Sector + Client/Project scope is supported.
// 3) Role checks are protected against missing role fields.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function authData() {
      return get(
        /databases/$(database)/documents/authorizedUsers/$(myEmail())
      ).data;
    }

    function authorized() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/authorizedUsers/$(myEmail())
        );
    }

    function isParentRole(data) {
      return data.role != null
        && (data.role.lower() == 'parent' || data.role.lower() == 'admin');
    }

    function isParent() {
      return authorized() && isParentRole(authData());
    }

    function myClientProject() {
      return authorized() && authData().clientproject != null
        ? authData().clientproject
        : '__none__';
    }

    function mySector() {
      return authorized() && authData().sector != null
        ? authData().sector
        : '__none__';
    }

    function inScope(data) {
      return data.clientproject == myClientProject()
        || (mySector() != '__none__'
            && data.sector != null
            && data.sector == mySector());
    }

    // ---------- authorizedUsers ----------
    match /authorizedUsers/{email} {
      allow get: if signedIn()
        && (myEmail() == email || isParent());

      allow list: if isParent();

      allow create, update: if isParent();

      // Protect Parent/Admin seed accounts from deletion.
      allow delete: if isParent()
        && !(resource.data.role != null
             && (resource.data.role.lower() == 'parent'
                 || resource.data.role.lower() == 'admin'));
    }

    // ---------- records / Long Roll ----------
    match /records/{recordId} {
      allow read: if isParent()
        || (authorized() && inScope(resource.data));

      // FIX: CREATE MUST USE request.resource.data
      allow create: if isParent()
        || (authorized() && inScope(request.resource.data));

      allow update: if isParent()
        || (authorized()
            && inScope(resource.data)
            && inScope(request.resource.data));

      allow delete: if isParent()
        || (authorized() && inScope(resource.data));
    }

    // ---------- recycleBin ----------
    match /recycleBin/{recordId} {
      allow read: if isParent()
        || (authorized() && inScope(resource.data));

      // FIX: CREATE MUST USE request.resource.data
      allow create: if isParent()
        || (authorized() && inScope(request.resource.data));

      allow update: if isParent()
        || (authorized() && inScope(resource.data));

      allow delete: if isParent()
        || (authorized() && inScope(resource.data));
    }

    // ---------- regionCatalog / sectorCatalog ----------
    match /regionCatalog/{regionId} {
      allow read: if authorized();
      allow write: if isParent();
    }

    match /sectorCatalog/{sectorId} {
      allow read: if authorized();
      allow write: if isParent();
    }

    // ---------- auditLogs ----------
    match /auditLogs/{logId} {
      allow read: if isParent();
      allow create: if authorized();
      allow update, delete: if false;
    }

    // ---------- transferHistory ----------
    match /transferHistory/{historyId} {
      allow read, create: if isParent();
      allow update, delete: if false;
    }

    // ---------- deny everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
