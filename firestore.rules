rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/authorizedUsers/$(email()));
    }

    function isAuthorized() {
      return signedIn()
        && exists(/databases/$(database)/documents/authorizedUsers/$(email()));
    }

    function role() {
      return isAuthorized() ? userDoc().data.get('role', '').lower() : '';
    }

    function isParent() {
      return isAuthorized() && (role() == 'parent' || role() == 'admin');
    }

    function isRegional() {
      return isAuthorized() && role() == 'regional';
    }

    function myRegion() {
      return isAuthorized() ? userDoc().data.get('region', '') : '';
    }

    function myRegionId() {
      return isAuthorized() ? userDoc().data.get('regionId', '') : '';
    }

    function mySector() {
      return isAuthorized() ? userDoc().data.get('sector', '') : '';
    }

    function myClient() {
      return isAuthorized() ? userDoc().data.get('clientproject', '') : '';
    }

    function regionalRecord(data) {
      return isRegional() && (
        data.get('region', '') == myRegion()
        || data.get('regionId', '') == myRegionId()
      );
    }

    function sectorRecord(data) {
      return isAuthorized()
        && mySector() != ''
        && data.get('sector', '') == mySector();
    }

    function clientRecord(data) {
      return isAuthorized()
        && myClient() != ''
        && data.get('clientproject', '') == myClient();
    }

    // Authorized users
    match /authorizedUsers/{userEmail} {
      allow get: if isParent() || (signedIn() && email() == userEmail);
      allow list: if isParent();
      allow create, update, delete: if isParent();
    }

    // Long Roll records
    match /records/{recordId} {
      allow get: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);
      allow list: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);

      allow create: if isParent()
        || regionalRecord(request.resource.data)
        || sectorRecord(request.resource.data)
        || clientRecord(request.resource.data);

      allow update: if isParent()
        || (regionalRecord(resource.data) && regionalRecord(request.resource.data))
        || (sectorRecord(resource.data) && sectorRecord(request.resource.data))
        || (clientRecord(resource.data) && clientRecord(request.resource.data));

      allow delete: if isParent()
        || regionalRecord(resource.data)
        || sectorRecord(resource.data)
        || clientRecord(resource.data);
    }

    // Recycle Bin
    match /recycleBin/{recordId} {
      allow get: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);
      allow list: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);
      allow create: if isParent() || regionalRecord(request.resource.data) || sectorRecord(request.resource.data) || clientRecord(request.resource.data);
      allow update: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);
      allow delete: if isParent() || regionalRecord(resource.data) || sectorRecord(resource.data) || clientRecord(resource.data);
    }

    // Regions
    match /regionCatalog/{regionId} {
      allow get: if isParent()
        || (isRegional() && (regionId == myRegionId() || resource.data.get('name', '') == myRegion()));
      allow list: if isParent();
      allow create: if isParent();
      allow update: if isParent()
        || (isRegional()
          && (regionId == myRegionId() || resource.data.get('name', '') == myRegion())
          && request.resource.data.get('name', '') == myRegion());
      allow delete: if isParent();
    }

    // Sectors
    match /sectorCatalog/{sectorId} {
      allow get: if isParent()
        || (isRegional() && resource.data.get('region', '') == myRegion());
      allow list: if isParent()
        || (isRegional() && resource.data.get('region', '') == myRegion());

      allow create: if isParent()
        || (isRegional() && request.resource.data.get('region', '') == myRegion());

      allow update: if isParent()
        || (isRegional()
          && resource.data.get('region', '') == myRegion()
          && request.resource.data.get('region', '') == myRegion());

      allow delete: if isParent();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow get: if isParent()
        || (isRegional() && (resource.data.get('regionId', '') == myRegionId() || resource.data.get('userEmail', '') == email()));
      allow list: if isParent();
      allow create: if isAuthorized();
      allow update, delete: if false;
    }

    // Transfer history
    match /transferHistory/{historyId} {
      allow get, list, create: if isParent();
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
