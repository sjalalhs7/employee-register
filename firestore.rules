rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email));
    }

    function isParent() {
      return signedIn() && myUser().data.role == 'parent';
    }

    function isClient() {
      return signedIn() && myUser().data.role == 'client';
    }

    function myClient() {
      return myUser().data.clientproject;
    }

    match /authorizedUsers/{email} {
      allow read: if signedIn() && (isParent() || email == request.auth.token.email);
      allow create, update, delete: if isParent();
    }

    match /records/{recordId} {
      allow read: if isParent() || (isClient() && resource.data.clientproject == myClient());
      allow create: if isParent() || (isClient() && request.resource.data.clientproject == myClient());
      allow update: if isParent()
        || (isClient()
            && resource.data.clientproject == myClient()
            && request.resource.data.clientproject == myClient());
      allow delete: if isParent();
    }

    match /auditLogs/{logId} {
      allow read: if isParent();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow read: if isParent();
      allow create: if isParent();
      allow update, delete: if false;
    }
  }
}
