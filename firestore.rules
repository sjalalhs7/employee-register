rules_version = '2';

// ============================================================================
// MSM LONGROLL DATABASE — Firestore Security Rules • FINAL PROFESSIONAL CLOUD RBAC
// Matched exactly to index.html: collections, field names and role model below.
// Deploy target: msm-security-guards-database (Firebase Console → Firestore → Rules)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myAuthDoc() {
      return get(/databases/$(database)/documents/authorizedUsers/$(myEmail()));
    }
    function authorized() {
      return signedIn() && exists(/databases/$(database)/documents/authorizedUsers/$(myEmail()));
    }
    function myRole() {
      return authorized() ? myAuthDoc().data.role.lower() : '';
    }
    function isParent() {
      return authorized() && (myRole() == 'parent' || myRole() == 'admin');
    }
    function myClient() {
      return authorized() ? myAuthDoc().data.clientproject : '__none__';
    }
    function mySector() {
      return authorized() ? myAuthDoc().data.sector : '__none__';
    }
    function inMyScope(data) {
      return data.clientproject == myClient() || (mySector() != '__none__' && data.sector == mySector());
    }

    // ---------- authorizedUsers ----------
    // Doc id = lowercase email. Every signed-in user must be able to read their OWN
    // doc (that is how the app decides role / client / sector on login).
    // Only Parent/Admin may list everyone or write access records.
    match /authorizedUsers/{email} {
      allow get:    if signedIn() && (myEmail() == email || isParent());
      allow list:   if isParent();
      allow create, update, delete: if isParent();
    }

    // ---------- records (the Long Roll register) ----------
    match /records/{recordId} {
      allow read:   if isParent() || (authorized() && inMyScope(resource.data));
      allow create: if isParent() || (authorized() && inMyScope(request.resource.data));
      allow update: if isParent() || (authorized() && inMyScope(resource.data) && inMyScope(request.resource.data));
      allow delete: if isParent() || (authorized() && inMyScope(resource.data));
    }

    // ---------- recycleBin (soft-deleted records) ----------
    match /recycleBin/{recordId} {
      allow read:   if isParent() || (authorized() && inMyScope(resource.data));
      allow create: if isParent() || (authorized() && inMyScope(resource.data));
      allow update: if isParent() || (authorized() && inMyScope(resource.data));
      allow delete: if isParent() || (authorized() && inMyScope(resource.data));
    }

    // ---------- regionCatalog / sectorCatalog ----------
    // Every authorized user needs to READ these (dropdowns, filters).
    // Only Parent/Admin may add, rename or re-assign regions/sectors.
    match /regionCatalog/{regionId} {
      allow read:  if authorized();
      allow write: if isParent();
    }
    match /sectorCatalog/{sectorId} {
      allow read:  if authorized();
      allow write: if isParent();
    }

    // ---------- auditLogs (Unified Activity Log — Parent/Admin only view) ----------
    match /auditLogs/{logId} {
      allow read:   if isParent();
      allow create: if authorized();           // every user logs their own actions
      allow update, delete: if false;          // logs are permanent, never edited
    }

    // ---------- transferHistory (Bulk Transfer — Parent only) ----------
    match /transferHistory/{historyId} {
      allow read:   if isParent();
      allow create: if isParent();
      allow update, delete: if false;
    }


    // ---------- companySettings ----------
    // Shared company/about/contact/navigation settings.
    // All authorized users may read; only Parent/Admin may create/update.
    match /companySettings/{settingId} {
      allow read: if authorized();
      allow create, update: if isParent();
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
