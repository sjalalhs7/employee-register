rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userPath() {
      return /databases/$(database)/documents/authorizedUsers/$(email());
    }

    function authorized() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function role() {
      return authorized() ? userDoc().data.get('role', '').lower() : '';
    }

    function isParent() {
      return authorized() && (role() == 'parent' || role() == 'admin');
    }

    function isClient() {
      return authorized() && role() == 'client';
    }

    function isRegional() {
      return authorized() && role() == 'regional';
    }

    function myClient() {
      return authorized() ? userDoc().data.get('clientproject', '') : '';
    }

    function mySector() {
      return authorized() ? userDoc().data.get('sector', '') : '';
    }

    function mySectorId() {
      return authorized() ? userDoc().data.get('sectorId', '') : '';
    }

    function myRegionId() {
      return authorized() ? userDoc().data.get('regionId', '') : '';
    }

    function clientRecord(data) {
      return isClient()
        && myClient() != ''
        && data.get('clientproject', '') == myClient()
        && (
          (mySectorId() == '' && mySector() == '')
          || (mySectorId() != '' && data.get('sectorId', '') == mySectorId())
          || (mySectorId() == '' && mySector() != ''
              && data.get('sector', '') == mySector())
        );
    }

    function regionalRecord(data) {
      return isRegional()
        && myRegionId() != ''
        && data.get('regionId', '') == myRegionId();
    }

    function scopedRecord(data) {
      return clientRecord(data) || regionalRecord(data);
    }

    match /authorizedUsers/{userEmail} {
      allow get: if isParent()
        || (signedIn() && email() == userEmail);
      allow list: if isParent();
      allow create, update: if isParent();
      allow delete: if isParent()
        && !(resource.data.get('role', '').lower() in ['parent', 'admin']);
    }

    match /companySettings/{settingsId} {
      allow get: if authorized();
      allow list: if isParent();
      allow create, update, delete: if isParent();
    }

    match /records/{recordId} {
      allow get: if isParent() || scopedRecord(resource.data);
      allow list: if isParent() || scopedRecord(resource.data);
      allow create: if isParent() || scopedRecord(request.resource.data);
      allow update: if isParent()
        || (scopedRecord(resource.data)
            && scopedRecord(request.resource.data));
      allow delete: if isParent() || scopedRecord(resource.data);
    }

    match /recycleBin/{recordId} {
      allow get: if isParent() || scopedRecord(resource.data);
      allow list: if isParent() || scopedRecord(resource.data);
      allow create: if isParent() || scopedRecord(request.resource.data);
      allow update: if isParent()
        || (scopedRecord(resource.data)
            && scopedRecord(request.resource.data));
      allow delete: if isParent() || scopedRecord(resource.data);
    }

    match /regionCatalog/{regionId} {
      allow get: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && regionId == myRegionId());

      allow list: if isParent();
      allow create, delete: if isParent();

      allow update: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && regionId == myRegionId()
            && request.resource.data.get('regionId', '') == regionId
            && resource.data.get('regionId', '') == regionId);
    }

    match /sectorCatalog/{sectorId} {
      allow get: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId());

      allow list: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId());

      allow create: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && request.resource.data.get('regionId', '') == myRegionId());

      allow update: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId()
            && request.resource.data.get('regionId', '') == myRegionId());

      allow delete: if isParent();
    }

    match /auditLogs/{logId} {
      allow get: if isParent()
        || (isRegional()
            && (resource.data.get('regionId', '') == myRegionId()
                || resource.data.get('userEmail', '') == email()))
        || (isClient()
            && resource.data.get('userEmail', '') == email());

      allow list: if isParent();

      allow create: if authorized()
        && request.resource.data.get('userEmail', '') == email()
        && (
          !isRegional()
          || request.resource.data.get('regionId', '') == ''
          || request.resource.data.get('regionId', '') == myRegionId()
        );

      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow get, list, create: if isParent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
