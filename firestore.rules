rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? request.auth.token.email : '';
    }

    function myUserExists() {
      return signedIn() && exists(
        /databases/$(database)/documents/authorizedUsers/$(userEmail())
      );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/authorizedUsers/$(userEmail())
      );
    }

    function authorized() {
      return myUserExists();
    }

    function parent() {
      return authorized() && myUser().data.role == 'parent';
    }

    function clientUser() {
      return authorized() && myUser().data.role == 'client';
    }

    function clientProjectMatches(data) {
      return clientUser()
        && data.clientproject == myUser().data.get('clientproject', '');
    }

    function clientSectorMatches(data) {
      return !('sector' in myUser().data)
        || myUser().data.get('sector', '') == ''
        || data.sector == myUser().data.get('sector', '');
    }

    // Authorized accounts. Only Parent can change access assignments.
    match /authorizedUsers/{email} {
      allow read: if parent() || (authorized() && email == userEmail());
      allow create, update, delete: if parent();
    }

    // Active long-roll records.
    match /records/{recordId} {
      allow read: if parent()
                  || (clientProjectMatches(resource.data) && clientSectorMatches(resource.data));

      allow create: if parent()
                    || (clientProjectMatches(request.resource.data) && clientSectorMatches(request.resource.data));

      allow update: if parent()
                    || (clientProjectMatches(resource.data)
                        && clientProjectMatches(request.resource.data)
                        && clientSectorMatches(resource.data)
                        && clientSectorMatches(request.resource.data));

      // Normal delete is permitted for the assigned client/sector, but the UI
      // moves records into recycleBin before deleting the active record.
      allow delete: if parent()
                    || (clientProjectMatches(resource.data) && clientSectorMatches(resource.data));
    }

    // Recycle Bin: Parent has full control. A client may only create a recycle
    // item for a record belonging to their own assigned client/sector. Clients
    // cannot read, recover, permanently delete, or empty the bin.
    match /recycleBin/{recycleId} {
      allow read: if parent();
      allow create: if parent()
                    || (clientUser()
                        && request.resource.data.deletedBy == userEmail()
                        && request.resource.data.deletedByRole == myUser().data.role
                        && request.resource.data.clientproject == myUser().data.get('clientproject', '')
                        && clientSectorMatches(request.resource.data.recordData));
      allow update, delete: if parent();
    }

    // Dynamic Parent-managed sector catalog.
    match /sectorCatalog/{sectorId} {
      allow read, create, update, delete: if parent();
    }

    // Append-only audit trail. Parent reads; any authorized account may create
    // an entry only as itself and with its own assigned role/project.
    match /auditLogs/{logId} {
      allow read: if parent();
      allow create: if authorized()
                    && request.resource.data.userEmail == userEmail()
                    && request.resource.data.role == myUser().data.role
                    && request.resource.data.clientproject == myUser().data.get('clientproject', '');
      allow update, delete: if false;
    }

    // Parent-only permanent transfer history.
    match /transferHistory/{transferId} {
      allow read, create: if parent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
