rules_version = '2';

// ============================================================================
// MSM LONGROLL DATABASE — Firestore Security Rules • FINAL PROFESSIONAL CLOUD RBAC
// OPTIMIZED: each rule now does max 2 document reads (exists + get) instead of
// 4–8, avoiding the 20 get()/exists() per-request limit that can silently
// cause "permission-denied" on nested reads (e.g. update rules that check
// both resource.data and request.resource.data).
// Deploy target: msm-security-guards-database (Firebase Console → Firestore → Rules)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function authorized() {
      return signedIn() && exists(/databases/$(database)/documents/authorizedUsers/$(myEmail()));
    }
    // Call this ONCE per rule and reuse the result — avoids repeated get() calls.
    function authData() {
      return get(/databases/$(database)/documents/authorizedUsers/$(myEmail())).data;
    }
    function isParentRole(auth) {
      return auth.role.lower() == 'parent' || auth.role.lower() == 'admin';
    }
    function inScope(auth, data) {
      return data.clientproject == auth.clientproject
        || ((auth.sector != null && auth.sector != '__none__') && data.sector == auth.sector);
    }

    // ---------- authorizedUsers ----------
    match /authorizedUsers/{email} {
      allow get:    if signedIn() && (myEmail() == email || (authorized() && isParentRole(authData())));
      allow list:   if authorized() && isParentRole(authData());
      allow create, update, delete: if authorized() && isParentRole(authData());
    }

    // ---------- records (the Long Roll register) ----------
    match /records/{recordId} {
      allow read, delete: if authorized() && (isParentRole(authData()) || inScope(authData(), resource.data));
      allow create: if authorized() && (isParentRole(authData()) || inScope(authData(), request.resource.data));
      allow update: if authorized() && (isParentRole(authData()) || (inScope(authData(), resource.data) && inScope(authData(), request.resource.data)));
    }

    // ---------- recycleBin (soft-deleted records) ----------
    match /recycleBin/{recordId} {
      allow read, create, update, delete: if authorized() && (isParentRole(authData()) || inScope(authData(), resource.data));
    }

    // ---------- regionCatalog / sectorCatalog ----------
    match /regionCatalog/{regionId} {
      allow read:  if authorized();
      allow write: if authorized() && isParentRole(authData());
    }
    match /sectorCatalog/{sectorId} {
      allow read:  if authorized();
      allow write: if authorized() && isParentRole(authData());
    }

    // ---------- auditLogs (Parent/Admin only view) ----------
    match /auditLogs/{logId} {
      allow read:   if authorized() && isParentRole(authData());
      allow create: if authorized();
      allow update, delete: if false;
    }

    // ---------- transferHistory (Bulk Transfer — Parent only) ----------
    match /transferHistory/{historyId} {
      allow read, create: if authorized() && isParentRole(authData());
      allow update, delete: if false;
    }

    // ---------- companySettings ----------
    match /companySettings/{settingId} {
      allow read: if authorized();
      allow create, update: if authorized() && isParentRole(authData());
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
