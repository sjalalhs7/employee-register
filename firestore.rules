rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function authorized() {
      return signedIn()
        && exists(/databases/$(database)/documents/authorizedUsers/$(myEmail()));
    }

    function myUser() {
      return get(/databases/$(database)/documents/authorizedUsers/$(myEmail())).data;
    }

    function isParent() {
      return authorized()
        && myUser().role is string
        && (myUser().role.lower() == 'parent'
            || myUser().role.lower() == 'admin');
    }

    function myClient() {
      return myUser().clientproject;
    }

    function mySector() {
      return myUser().sector;
    }

    // FIX: null == null no longer grants scope. A user or record missing
    // clientproject/sector can never match on that field.
    function inScope(data) {
      return (myClient() != null
              && 'clientproject' in data
              && data.clientproject == myClient())
          || (mySector() != null
              && 'sector' in data
              && data.sector == mySector());
    }

    // Restrict what fields a record write may contain and their types.
    // Adjust the field list to match your actual record schema.
    function validRecordFields(data) {
      return data.keys().hasOnly([
        'clientproject', 'sector', 'title', 'description',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && (!('clientproject' in data) || data.clientproject is string)
      && (!('sector' in data) || data.sector is string);
    }

    match /authorizedUsers/{email} {
      allow get: if signedIn()
        && (myEmail() == email || isParent());

      allow list: if isParent();

      allow create, update: if isParent();

      allow delete: if isParent()
        && !(resource.data.role is string
             && (resource.data.role.lower() == 'parent'
                 || resource.data.role.lower() == 'admin'));
    }

    match /records/{recordId} {
      allow read: if isParent()
        || (authorized() && inScope(resource.data));

      allow create: if isParent()
        || (authorized()
            && inScope(request.resource.data)
            && validRecordFields(request.resource.data));

      allow update: if isParent()
        || (authorized()
            && inScope(resource.data)
            && inScope(request.resource.data)
            && validRecordFields(request.resource.data));

      allow delete: if isParent()
        || (authorized() && inScope(resource.data));
    }

    match /recycleBin/{recordId} {
      allow read: if isParent()
        || (authorized() && inScope(resource.data));

      allow create: if isParent()
        || (authorized()
            && inScope(request.resource.data)
            && validRecordFields(request.resource.data));

      allow update: if isParent()
        || (authorized() && inScope(resource.data));

      allow delete: if isParent()
        || (authorized() && inScope(resource.data));
    }

    match /regionCatalog/{regionId} {
      allow read: if authorized();
      allow write: if isParent();
    }

    match /sectorCatalog/{sectorId} {
      allow read: if authorized();
      allow write: if isParent();
    }

    match /auditLogs/{logId} {
      allow read: if isParent();
      // FIX: any authorized user could create arbitrary/fake audit entries.
      // Now the log's actor field must match the caller's own email.
      allow create: if authorized()
        && request.resource.data.actor is string
        && request.resource.data.actor.lower() == myEmail();
      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow read, create: if isParent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
