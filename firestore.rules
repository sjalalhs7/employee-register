rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUser() {
      return signedIn() && exists(
        /databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)
      );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)
      );
    }

    function isParent() {
      return hasUser() && myUser().data.role == 'parent';
    }

    function isClient() {
      return hasUser() && myUser().data.role == 'client';
    }

    function myClient() {
      return myUser().data.clientproject;
    }

    function clientScopeMatches(data) {
      return isClient()
        && data.clientproject == myClient()
        && (!('sector' in myUser().data) || !('sector' in data) || data.sector == myUser().data.sector);
    }

    match /authorizedUsers/{email} {
      allow read: if hasUser() && (isParent() || email == request.auth.token.email);
      allow create, update, delete: if isParent();
    }

    match /records/{recordId} {
      allow read: if isParent() || clientScopeMatches(resource.data);
      allow create: if isParent() || clientScopeMatches(request.resource.data);
      allow update: if isParent()
        || (clientScopeMatches(resource.data) && clientScopeMatches(request.resource.data));
      // Normal deletion is intentionally blocked. The application moves records
      // to recycleBin using a Parent-only batch operation.
      allow delete: if false;
    }

    match /recycleBin/{recordId} {
      allow read, create, update, delete: if isParent();
    }

    match /sectorCatalog/{sectorId} {
      allow read, create, update, delete: if isParent();
    }

    match /auditLogs/{logId} {
      allow read: if isParent();
      allow create: if hasUser()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.role == myUser().data.role
        && request.resource.data.clientproject == myUser().data.clientproject;
      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow read, create: if isParent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
