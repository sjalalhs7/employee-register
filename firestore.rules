rules_version = '2';

// MSM LONGROLL DATABASE — FINAL RBAC RULES
// Canonical identifiers:
//   authorizedUsers/{lowercase-email}
//   regionCatalog/{regionId}
//   sectorCatalog/{sectorId} -> regionId
//   records/{recordId} -> regionId + optional sectorId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userPath() {
      return /databases/$(database)/documents/authorizedUsers/$(email());
    }

    function authorized() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function role() {
      return authorized() ? userDoc().data.get('role', '').lower() : '';
    }

    function isParent() {
      return authorized() && (role() == 'parent' || role() == 'admin');
    }

    function isClient() {
      return authorized() && role() == 'client';
    }

    function isRegional() {
      return authorized() && role() == 'regional';
    }

    function myClient() {
      return authorized() ? userDoc().data.get('clientproject', '') : '';
    }

    function mySector() {
      return authorized() ? userDoc().data.get('sector', '') : '';
    }

    function mySectorId() {
      return authorized() ? userDoc().data.get('sectorId', '') : '';
    }

    function myRegionId() {
      return authorized() ? userDoc().data.get('regionId', '') : '';
    }

    // Client must always stay inside its client/project.
    // sectorId is preferred; legacy sector name remains supported for old client docs.
    function clientRecord(data) {
      return isClient()
        && myClient() != ''
        && data.get('clientproject', '') == myClient()
        && (
          (mySectorId() == '' && mySector() == '')
          || (mySectorId() != '' && data.get('sectorId', '') == mySectorId())
          || (mySectorId() == '' && mySector() != '' && data.get('sector', '') == mySector())
        );
    }

    // Regional scope is permanent regionId only.
    function regionalRecord(data) {
      return isRegional()
        && myRegionId() != ''
        && data.get('regionId', '') == myRegionId();
    }

    function scopedRecord(data) {
      return clientRecord(data) || regionalRecord(data);
    }

    match /authorizedUsers/{userEmail} {
      allow get: if isParent() || (signedIn() && email() == userEmail);
      allow list: if isParent();
      allow create, update: if isParent();
      allow delete: if isParent()
        && !(resource.data.get('role', '').lower() in ['parent', 'admin']);
    }

    match /companySettings/{settingsId} {
      allow get: if authorized();
      allow list: if isParent();
      allow create, update, delete: if isParent();
    }

    match /records/{recordId} {
      allow get: if isParent() || scopedRecord(resource.data);
      allow list: if isParent() || scopedRecord(resource.data);
      allow create: if isParent() || scopedRecord(request.resource.data);
      allow update: if isParent()
        || (scopedRecord(resource.data) && scopedRecord(request.resource.data));
      allow delete: if isParent() || scopedRecord(resource.data);
    }

    match /recycleBin/{recordId} {
      allow get: if isParent() || scopedRecord(resource.data);
      allow list: if isParent() || scopedRecord(resource.data);
      allow create: if isParent() || scopedRecord(request.resource.data);
      allow update: if isParent()
        || (scopedRecord(resource.data) && scopedRecord(request.resource.data));
      allow delete: if isParent() || scopedRecord(resource.data);
    }

    // Regional users can read/update only their own region document.
    // They cannot change the permanent regionId.
    match /regionCatalog/{regionId} {
      allow get: if isParent()
        || (isRegional() && myRegionId() != '' && regionId == myRegionId());
      allow list: if isParent();
      allow create, delete: if isParent();
      allow update: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && regionId == myRegionId()
            && request.resource.data.get('regionId', '') == resource.data.get('regionId', ''));
    }

    // Every sector has a permanent sectorId and regionId.
    // Regional queries must include where('regionId', '==', myRegionId()).
    match /sectorCatalog/{sectorId} {
      allow get: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId());
      allow list: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId());
      allow create: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && request.resource.data.get('regionId', '') == myRegionId());
      allow update: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId()
            && request.resource.data.get('regionId', '') == myRegionId());
      allow delete: if isParent();
    }

    // Audit entries are append-only and the signed-in user identity cannot be spoofed.
    match /auditLogs/{logId} {
      allow get: if isParent()
        || (isRegional()
            && (resource.data.get('regionId', '') == myRegionId()
                || resource.data.get('userEmail', '') == email()))
        || (isClient() && resource.data.get('userEmail', '') == email());
      allow list: if isParent();
      allow create: if authorized()
        && request.resource.data.get('userEmail', '') == email()
        && (!isRegional()
            || request.resource.data.get('regionId', '') == ''
            || request.resource.data.get('regionId', '') == myRegionId());
      allow update, delete: if false;
    }

    match /transferHistory/{historyId} {
      allow get, list, create: if isParent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
