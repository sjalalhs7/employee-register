rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // MSM SECURITY GUARDS PVT LTD - LONGROLL DATABASE
    // Source of truth: authorizedUsers/{lowercase-email}
    // Canonical region key: regionId only.

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function authUserPath() {
      return /databases/$(database)/documents/authorizedUsers/$(email());
    }

    function authorized() {
      return signedIn() && exists(authUserPath());
    }

    function authUser() {
      return get(authUserPath()).data;
    }

    function role() {
      return authorized() ? authUser().get('role', '').lower() : '';
    }

    function isParent() {
      return authorized() && (role() == 'parent' || role() == 'admin');
    }

    function isRegional() {
      return authorized() && role() == 'regional';
    }

    function isClient() {
      return authorized() && role() == 'client';
    }

    function myRegionId() {
      return authorized() ? authUser().get('regionId', '') : '';
    }

    function myClientProject() {
      return authorized() ? authUser().get('clientproject', '') : '';
    }

    function mySectorId() {
      return authorized() ? authUser().get('sectorId', '') : '';
    }

    function regionalScope(data) {
      return isRegional()
        && myRegionId() != ''
        && data.get('regionId', '') == myRegionId();
    }

    function clientScope(data) {
      return isClient()
        && myClientProject() != ''
        && data.get('clientproject', '') == myClientProject()
        && (mySectorId() == '' || data.get('sectorId', '') == mySectorId());
    }

    function recordScope(data) {
      return regionalScope(data) || clientScope(data);
    }

    // AUTHORIZED USERS
    match /authorizedUsers/{userEmail} {
      allow get: if isParent() || (signedIn() && email() == userEmail);
      allow list: if isParent();
      allow create, update: if isParent();
      allow delete: if isParent()
        && !(resource.data.get('role', '').lower() in ['parent', 'admin']);
    }

    // COMPANY SETTINGS
    match /companySettings/{settingsId} {
      allow get: if authorized();
      allow list: if isParent();
      allow create, update, delete: if isParent();
    }

    // REGION CATALOG
    match /regionCatalog/{regionId} {
      allow get: if isParent()
        || (isRegional() && myRegionId() != '' && regionId == myRegionId());

      allow list: if isParent();
      allow create, delete: if isParent();

      allow update: if isParent()
        || (
          isRegional()
          && myRegionId() != ''
          && regionId == myRegionId()
          && request.resource.data.get('regionId', regionId)
             == resource.data.get('regionId', regionId)
          && request.resource.data.get('regionId', regionId) == regionId
        );
    }

    // SECTOR CATALOG
    // Required fields: regionId, sectorId
    match /sectorCatalog/{sectorDocId} {
      allow get: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId())
        || (isClient()
            && mySectorId() != ''
            && resource.data.get('sectorId', sectorDocId) == mySectorId());

      allow list: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId())
        || (isClient()
            && mySectorId() != ''
            && resource.data.get('sectorId', sectorDocId) == mySectorId());

      allow create: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && request.resource.data.get('regionId', '') == myRegionId());

      allow update: if isParent()
        || (isRegional()
            && myRegionId() != ''
            && resource.data.get('regionId', '') == myRegionId()
            && request.resource.data.get('regionId', '') == myRegionId());

      allow delete: if isParent();
    }

    // LONG ROLL RECORDS
    match /records/{recordId} {
      allow get, list: if isParent() || recordScope(resource.data);
      allow create: if isParent() || recordScope(request.resource.data);
      allow update: if isParent()
        || (recordScope(resource.data) && recordScope(request.resource.data));
      allow delete: if isParent() || recordScope(resource.data);
    }

    // RECYCLE BIN
    match /recycleBin/{recordId} {
      allow get, list: if isParent() || recordScope(resource.data);
      allow create: if isParent() || recordScope(request.resource.data);
      allow update: if isParent()
        || (recordScope(resource.data) && recordScope(request.resource.data));
      allow delete: if isParent() || recordScope(resource.data);
    }

    // AUDIT LOGS - immutable and anti-spoofing
    match /auditLogs/{logId} {
      allow get: if isParent()
        || (isRegional() && (
              resource.data.get('regionId', '') == myRegionId()
              || resource.data.get('userEmail', '') == email()
            ))
        || (isClient() && resource.data.get('userEmail', '') == email());

      allow list: if isParent()
        || (isRegional()
            && resource.data.get('regionId', '') == myRegionId())
        || (isClient()
            && resource.data.get('userEmail', '') == email());

      allow create: if authorized()
        && request.resource.data.get('userEmail', '') == email()
        && (
          isParent()
          || (isRegional() && (
                request.resource.data.get('regionId', '') == ''
                || request.resource.data.get('regionId', '') == myRegionId()
              ))
          || isClient()
        );

      allow update, delete: if false;
    }

    // TRANSFER HISTORY
    match /transferHistory/{historyId} {
      allow get, list, create: if isParent();
      allow update, delete: if false;
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
