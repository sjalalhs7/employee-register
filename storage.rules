rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function authorized() {
      return signedIn() && firestore.exists(
        /databases/(default)/documents/authorizedUsers/$(request.auth.token.email.lower())
      );
    }
    match /enrollment/{uid}/{recordId}/{fileName} {
      allow read, write: if authorized() && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
